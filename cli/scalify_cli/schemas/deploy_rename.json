{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalify.khulnasoft.com/schemas/deploy_rename.json",
  "title": "scalify deploy rename --json data payload",
  "type": "object",
  "required": [
    "deployment",
    "previousName"
  ],
  "additionalProperties": false,
  "properties": {
    "deployment": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "previousName": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "The name the deployment held before, null where it had none."
    }
  }
}
