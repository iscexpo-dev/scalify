{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalify.khulnasoft.com/schemas/build_ls.json",
  "title": "scalify build ls --json data payload",
  "type": "object",
  "required": ["builds"],
  "additionalProperties": true,
  "properties": {
    "builds": {
      "type": "array",
      "description": "The workspace's builds.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"}
        }
      }
    }
  }
}
